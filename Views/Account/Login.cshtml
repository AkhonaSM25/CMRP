@model LoginViewModel
@using CMRP.Data
@inject IConfiguration Config
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    var showDemo = Config.GetValue("Seed:DemoAccounts", true);
}

<div class="auth-card">
    <h1>Welcome to CMRP</h1>
    <p class="muted">Sign in or register to report and track campus maintenance issues.</p>

    <div class="auth-tabs" role="navigation" aria-label="Sign in or register">
        <a class="active" aria-current="page" asp-action="Login">Login</a>
        <a asp-action="Register">Register</a>
    </div>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" data-submit-lock>
        <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <div class="input-icon">
                <svg class="icon"><use href="#i-mail" /></svg>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" autocomplete="username" autofocus />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-icon">
                <svg class="icon"><use href="#i-lock" /></svg>
                <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                <button type="button" class="input-toggle" data-toggle-password="#Password" aria-label="Show password">
                    <svg class="icon"><use href="#i-eye" /></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>

    <p class="auth-foot">Don't have an account? <a asp-action="Register">Register here</a></p>

    @if (showDemo)
    {
        <details class="demo-accounts">
            <summary>Demo accounts</summary>
            <p class="muted">For marking and testing. Every demo account uses the password <code>@SeedData.DemoPassword</code>.</p>
            <table class="table table-sm mb-0">
                <tbody>
                    <tr><th scope="row">Reporter</th><td>@SeedData.ReporterEmail</td></tr>
                    <tr><th scope="row">Technician</th><td>@SeedData.TechnicianEmail</td></tr>
                    <tr><th scope="row">Coordinator</th><td>@SeedData.CoordinatorEmail</td></tr>
                    <tr><th scope="row">Administrator</th><td>@SeedData.AdminEmail</td></tr>
                </tbody>
            </table>
        </details>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
